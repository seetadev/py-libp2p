# --- Networking ---
LIBP2P_PORT=8000
# Set by the requester when connecting to a known responder, e.g.
# /ip4/127.0.0.1/tcp/8001/p2p/12D3KooW...
PEER_ADDRESS=

# --- LLM (via LiteLLM) ---
# Any LiteLLM-supported model string: gpt-4o-mini, claude-sonnet-4-6,
# ollama/llama3, gemini/gemini-1.5-flash, etc.
LLM_MODEL=gemini/gemini-3.6-flash
LLM_API_KEY=
GEMINI_API_KEY=
# Only needed for self-hosted / non-default endpoints (e.g. Ollama, Azure).
LLM_API_BASE=

# --- EtherCalc ---
ETHERCALC_URL=http://localhost:8000
ETHERCALC_SHEET=sales-analysis

# --- Misc ---
LOG_LEVEL=INFO
